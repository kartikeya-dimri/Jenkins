pipeline{
  agent any
  stages {
    stage('Build'){
      steps{
        echo 'This job is building stage'
      }
    }

    stage('Test'){
      steps{
        echo 'This job is testing stage'
      }
    }

    stage('Stage'){
      steps{
        echo 'This is staging environment'
      }
    }

    stage('Deploy'){
      steps{
        echo 'This is Deploying stage'
      }
    }

    stage('Monitor'){
      steps{
        echo 'This job is Monitoring stage'
      }
    }
    
  }
}
